  "turns": [
    {
      "turn_id": "b1-p1-t1",
      "p": 1,
      "seq": 1,
      "title": "Welcome to the Crew",
      "text": "Mags Thimbleby watches you from behind the bar, her eyes red from crying. Behind her, the door to the Gullet breathes slowly in and out. A goblin bar-back named Splurt stands guard with a mop, doing his best to look brave.",
      "requires": null,
      "options": [
        {
          "label": "Ask Mags what exactly the mimic swallowed.",
          "roll": {
            "skill": "persuasion",
            "dc": 6
          },
          "success": {
            "text": "She counts them off: the beer, the cellar, and Harold, her husband, in his urn. 'Bring Harold back,' she says quietly. 'The beer can stay.'",
            "effects": [
              {
                "type": "location",
                "value": "tavern"
              },
              {
                "type": "flag",
                "key": "knows_urn",
                "value": true,
                "scope": "world"
              }
            ],
            "goto": null
          },
          "fail": {
            "text": "'Everything,' she says, and cries into a bar rag. Splurt fills in the rest, though not all of it is accurate.",
            "effects": [
              {
                "type": "location",
                "value": "tavern"
              },
              {
                "type": "flag",
                "key": "knows_urn",
                "value": true,
                "scope": "world"
              }
            ],
            "goto": null
          }
        },
        {
          "label": "Inspect the Gullet door.",
          "roll": {
            "skill": "investigation",
            "dc": 8
          },
          "success": {
            "text": "The doorframe is lined with teeth, smooth and patient. When the fireplace pops, the whole door flinches. It doesn't like heat.",
