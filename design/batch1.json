                "type": "flag",
                "key": "cat_ally",
                "value": true
              }
            ],
            "goto": null
          },
          "fail": {
            "text": "The cat scratches your face on the way out. Fair enough.",
            "effects": [
              {
                "type": "hp",
                "target": "self",
                "delta": -1
              }
