            "goto": null
          }
        },
        {
          "label": "Let him go. He'll come back. Probably.",
          "roll": null,
          "success": {
            "text": "Splurt vanishes with a sad little sound. Twenty minutes later he walks in from upstairs, bewildered but alive. Death works strangely here.",
            "effects": [
