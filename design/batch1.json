      "options": [
        {
          "label": "Free the cat.",
          "roll": {
            "skill": "animal_handling",
            "dc": 7
          },
          "success": {
            "text": "The cat ignores you completely, which is how you know it's grateful. It follows you anyway.",
            "effects": [
