            "effects": [],
            "goto": null
          },
          "fail": {
            "text": "It clenches harder. Splurt steps in to tickle it, and it opens for him at once.",
            "effects": [],
            "goto": null
          }
        },
        {
          "label": "Knock politely and ask.",
          "roll": null,
          "success": {
