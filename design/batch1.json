                "value": "tavern"
              },
              {
                "type": "flag",
                "key": "mimic_hates_heat",
                "value": true,
                "scope": "world"
              }
            ],
            "goto": null
          },
          "fail": {
            "text": "You lean in close and the door licks you. You're coated in warm slobber, and everyone can smell it.",
            "effects": [
              {
                "type": "location",
                "value": "tavern"
              },
              {
                "type": "flag",
                "key": "slimed",
                "value": true
              }
            ],
            "goto": null
          }
        },
        {
          "label": "Talk with Splurt.",
          "roll": null,
          "success": {
            "text": "Splurt tells you he's Head of Security, and also Head of Mops. He'll follow you down, he says. He's scared, but he means it.",
