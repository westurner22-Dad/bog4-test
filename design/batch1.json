      "options": [
        {
          "label": "Use fire.",
          "roll": {
            "skill": "arcana",
            "dc": 6
          },
          "success": {
            "text": "The door shudders at the heat and opens. You step through with most of your dignity.",
            "effects": [],
            "goto": null
          },
          "fail": {
            "text": "You singe your own eyebrows. The door opens anyway, almost out of pity.",
            "effects": [
              {
                "type": "hp",
                "target": "self",
                "delta": -1
              }
            ],
            "goto": null
          }
        },
        {
          "label": "Tickle it.",
          "roll": {
            "skill": "sleight_of_hand",
            "dc": 8
          },
          "success": {
