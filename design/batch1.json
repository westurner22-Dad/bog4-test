    {
      "turn_id": "b1-p1-t9",
      "p": 1,
      "seq": 9,
      "title": "Splurt's Big Moment",
      "text": "Splurt slips on the rug, which turns out to be a tongue, and is hauled up toward the ceiling, which turns out to be a mouth. 'Don't leave me!' he cries.",
      "requires": null,
      "options": [
        {
          "label": "Grab his ankle.",
          "roll": {
            "skill": "athletics",
            "dc": 8
          },
          "success": {
            "text": "You catch him and pull him down. He hugs you for a long, grateful moment.",
            "effects": [
              {
                "type": "flag",
                "key": "splurt_saved",
                "value": true
              }
            ],
            "goto": null
          },
          "fail": {
            "text": "You both go up, and you both come down hard.",
            "effects": [
              {
                "type": "hp",
                "target": "self",
                "delta": -2
